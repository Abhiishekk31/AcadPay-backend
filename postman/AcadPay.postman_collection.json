	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"email\": \"user@example.com\",\n\t\"password\": \"yourpassword\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"email\": \"user@example.com\",\n\t\"password\": \"yourpassword\",\n\t\"firstName\": \"John\",\n\t\"lastName\": \"Doe\",\n\t\"role\": \"ADMIN\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": ["{{base_url}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "Generate Sign",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"school_id\": \"school123\",\n\t\"collect_request_id\": \"req456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/generate-sign",
							"host": ["{{base_url}}"],
							"path": ["auth", "generate-sign"]
						}
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
