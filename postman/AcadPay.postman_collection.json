		{
			"name": "Payments",
			"item": [
				{
					"name": "Create Payment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"amount\": \"1000\",\n\t\"callback_url\": \"http://localhost:3000/webhook\",\n\t\"student_info\": {\n\t\t\"name\": \"Jane Smith\",\n\t\t\"id\": \"STU001\",\n\t\t\"email\": \"jane.smith@example.com\"\n\t}\n}"
						},
						"url": {
							"raw": "{{base_url}}/create-payment",
							"host": ["{{base_url}}"],
							"path": ["create-payment"]
						}
					}
				},
				{
					"name": "Get Payment Status",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/payment-status/req456?school_id=school123",
							"host": ["{{base_url}}"],
							"path": ["payment-status", "req456"],
							"query": [
								{
									"key": "school_id",
									"value": "school123"
								}
							]
						}
					}
				},
				{
					"name": "Webhook Handler",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"status\": 200,\n\t\"order_info\": {\n\t\t\"order_id\": \"ord789\",\n\t\t\"order_amount\": 1000,\n\t\t\"transaction_amount\": 1000,\n\t\t\"gateway\": \"Stripe\",\n\t\t\"bank_reference\": \"ref123\",\n\t\t\"status\": \"SUCCESS\",\n\t\t\"payment_mode\": \"CARD\",\n\t\t\"payment_details\": \"Visa\",\n\t\t\"payment_message\": \"Payment completed\",\n\t\t\"payment_time\": \"2024-01-01T12:00:00Z\",\n\t\t\"error_message\": \"\"\n\t}\n}"
						},
						"url": {
							"raw": "{{base_url}}/webhook",
							"host": ["{{base_url}}"],
							"path": ["webhook"]
						}
					}
				},
